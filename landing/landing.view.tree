$piterjs_landing $mol_view
	meetup $piterjs_meetup
	meetups /
	attr *
		^
		piterjs_landing_rsvp_open <= rsvp_open false
	nav_titles *
		hero \Главная
		manifesto \Манифест
		schedule \Доклады
		archive \Архив
		community \Сообщество
	sub /
		<= Header $piterjs_landing_header
			logo_version_tag <= logo_version_tag \
			rsvp_btn_text <= rsvp_btn_text \
			rsvp_shown <= rsvp_shown true
			nav_titles <= nav_titles
			nav_current <= nav_current \
			nav_pick*? <=> nav_pick*? null
			rsvp_click? <=> rsvp_click? null
			burger_open? <=> burger_open? false
		<= Main $mol_view
			dom_name \main
			sub /
				<= Hero $piterjs_landing_hero
					meetup <= meetup_current $piterjs_meetup
					loading <= meetup_loading false
					passed <= meetup_passed false
					meetup_title <= meetup_title \
					next_num <= next_num \
					free_slots <= free_slots \
					next_event_time <= next_event_time \
					next_event_place <= next_event_place \
					now_time <= now_time 0
					cfp_open? <=> cfp_open? null
				<= Manifesto $piterjs_landing_manifesto
				<= Schedule $piterjs_landing_schedule
					meetup <= meetup_current $piterjs_meetup
					meetup_title <= meetup_title \
					cfp_open? <=> cfp_open? null
				<= Archive $piterjs_landing_archive
					meetups <= meetups
				<= Community $piterjs_landing_community
				<= Footer $piterjs_landing_footer
		<= Rsvp $piterjs_landing_rsvp
			meetup <= meetup_current $piterjs_meetup
			meetup_title <= meetup_title \
			next_event_time <= next_event_time \
			next_event_place <= next_event_place \
			free_slots <= free_slots \
			rsvp_close? <=> rsvp_close? null
		<= Cfp $piterjs_landing_cfp
			cfp_close? <=> cfp_close? null
			toast? <=> toast_message? \
		<= Toast $mol_view
			sub / <= toast_message \
